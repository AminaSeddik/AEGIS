    { from: 'dist_switch1', to: 'er_switch' },
    { from: 'dist_switch2', to: 'ward_switch' },
    { from: 'dist_switch2', to: 'or_switch' },
    // ICU
    { from: 'icu_switch', to: 'icu_wifi' },
    ...['vent1','vent2','vent3','vent4','vent5','ecg_icu1','ecg_icu2','ecg_icu3','ecg_icu4','ecg_icu5',
        'pump1','pump2','pump3','pump4','pump5','pump6','pump7','pump8','pump9','pump10',
        'pat_icu1','pat_icu2','pat_icu3','pat_icu4','pat_icu5'].map(id => ({ from: 'icu_wifi', to: id })),
    // ER
    { from: 'er_switch', to: 'er_wifi' },
    ...['defib1','defib2','defib3','defib4','ecg_er1','ecg_er2','ecg_er3','ecg_er4',
        'vital1','vital2','vital3','vital4','vital5','vital6','vital7','vital8',
        'xray1','xray2','xray3','xray4'].map(id => ({ from: 'er_wifi', to: id })),
    // Ward
    { from: 'ward_switch', to: 'ward_wifi' },
    ...['pat_w1','pat_w2','pat_w3','pat_w4','pat_w5','pat_w6','pat_w7','pat_w8',
        'temp1','temp2','temp3','temp4','hr1','hr2','hr3','hr4',
        'nurse1','nurse2','nurse3','nurse4'].map(id => ({ from: 'ward_wifi', to: id })),
    // OR
    { from: 'or_switch', to: 'or_wifi' },
    ...['anes1','anes2','anes3','surg1','surg2','surg3','surg4','img1','img2','img3'].map(id => ({ from: 'or_wifi', to: id })),
    // Data Center
    ...['emr_server','pacs_server','db_server','backup','mqtt_broker','app1','app2','app3','app4','app5'].map(id => ({ from: 'dc_switch', to: id })),
    // Attack connections
    ...attackerNodes.map(a => ({ from: 'firewall', to: a.id, isAttack: true })),
  ];

  const totalAttacks = Object.entries(attackCounts).filter(([k]) => k !== 'Benign').reduce((sum, [, v]) => sum + v, 0);

  const getNodeColor = (type: string) => {
    switch (type) {
      case 'firewall': return 'bg-red-600';
      case 'router': return 'bg-purple-600';
      case 'switch': return 'bg-blue-600';
      case 'server': return 'bg-emerald-600';
      case 'device': return 'bg-cyan-600';
      case 'ids': return 'bg-yellow-500';
      case 'wifi': return 'bg-indigo-500';
      case 'gateway': return 'bg-gray-600';
      default: return 'bg-gray-600';
    }
  };

  const getNodeIcon = (type: string, attackType?: string) => {
    if (type === 'attacker') {
      const attack = ALL_ATTACK_TYPES.find(a => a.key === attackType);
      return <span className="text-xs">{attack?.icon || '⚠️'}</span>;
    }
    switch (type) {
      case 'firewall': return <span className="text-xs">🛡️</span>;
      case 'router': return <span className="text-xs">🔀</span>;
      case 'switch': return <span className="text-xs">🔌</span>;
      case 'server': return <span className="text-xs">🖥️</span>;
      case 'device': return <span className="text-xs">📟</span>;
      case 'ids': return <span className="text-xs">🔍</span>;
      case 'wifi': return <span className="text-xs">📶</span>;
      case 'gateway': return <span className="text-xs">🌐</span>;
      default: return <span className="text-xs">❓</span>;
    }
  };

  const getStatusIndicator = (status: string, type: string) => {
    if (type === 'attacker') return 'bg-red-500 animate-pulse';
    return status === 'online' ? 'bg-emerald-500' : status === 'warning' ? 'bg-yellow-500' : 'bg-red-500';
  };

  const textColor = isDark ? 'text-white' : 'text-slate-900';
  const textMuted = isDark ? 'text-gray-400' : 'text-slate-600';
  const textFaint = isDark ? 'text-gray-500' : 'text-slate-500';
  const bgCard = isDark ? 'bg-gradient-to-br from-[#0d1424] to-[#1a1f2e]' : 'bg-white';
  const bgMap = isDark ? 'bg-[#080c14]' : 'bg-slate-100';
  const borderColor = isDark ? 'border-gray-800' : 'border-slate-200';

  return (
    <div className="space-y-4">
      {/* Header */}
      <div className="flex items-center justify-between">
        <div>
          <h1 className={`text-2xl font-bold ${textColor}`}>Network Topology</h1>
          <p className={textMuted}>Hospital IoT Network - 85 Medical Devices</p>
        </div>
        <div className="flex items-center space-x-3">
          <div className={`flex items-center space-x-2 px-3 py-1.5 rounded-lg ${isConnected ? 'bg-emerald-500/20' : 'bg-red-500/20'}`}>
            <div className={`w-2 h-2 rounded-full ${isConnected ? 'bg-emerald-500 animate-pulse' : 'bg-red-500'}`}></div>
            <span className={`text-xs font-medium ${isConnected ? 'text-emerald-400' : 'text-red-400'}`}>{isConnected ? 'LIVE' : 'OFFLINE'}</span>
          </div>
          {currentAttack !== 'None' && currentAttack !== 'Benign' && (
            <div className="flex items-center space-x-2 px-3 py-1.5 rounded-lg bg-red-500/20 animate-pulse">
              <span className="text-xs font-medium text-red-400">🔴 {currentAttack.replace('_', ' ')}</span>
            </div>
          )}
          <button onClick={() => setShowAttackers(!showAttackers)}
            className={`px-3 py-1.5 rounded-lg font-medium text-xs transition-all ${showAttackers ? 'bg-red-600 hover:bg-red-700 text-white' : 'bg-gray-700 hover:bg-gray-600 text-gray-300'}`}>
            {showAttackers ? '🔒 Hide Attackers' : '👁️ Show Attackers'}
          </button>
          <div className={`flex items-center space-x-2 ${isDark ? 'bg-[#1a1f2e]' : 'bg-slate-200'} rounded-lg px-2 py-1`}>
            <button onClick={() => setZoomLevel(Math.max(40, zoomLevel - 10))} className={`${textMuted} px-1`}>−</button>
            <span className={`text-xs w-10 text-center ${textColor}`}>{zoomLevel}%</span>
            <button onClick={() => setZoomLevel(Math.min(120, zoomLevel + 10))} className={`${textMuted} px-1`}>+</button>
          </div>
        </div>
      </div>

      {/* Stats */}
      <div className="grid grid-cols-4 gap-3">
        <div className={`${bgCard} rounded-lg p-3 border ${borderColor}`}>
          <p className={`${textMuted} text-xs`}>Total Devices</p>
          <p className={`text-xl font-bold ${textColor}`}>85</p>
        </div>
        <div className={`${bgCard} rounded-lg p-3 border ${borderColor}`}>
          <p className={`${textMuted} text-xs`}>Online</p>
          <p className="text-xl font-bold text-emerald-400">85</p>
        </div>
        <div className={`${bgCard} rounded-lg p-3 border ${borderColor}`}>
          <p className={`${textMuted} text-xs`}>Attacks</p>
          <p className="text-xl font-bold text-red-400">{totalAttacks}</p>
        </div>
        <div className={`${bgCard} rounded-lg p-3 border ${borderColor}`}>
          <p className={`${textMuted} text-xs`}>Attack Types</p>
          <p className="text-xl font-bold text-purple-400">{Object.entries(attackCounts).filter(([k, v]) => k !== 'Benign' && v > 0).length}/8</p>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-4 gap-4">
        {/* Network Map */}
        <div className={`lg:col-span-3 ${bgCard} rounded-xl border ${borderColor} overflow-hidden`}>
          <div className={`p-3 border-b ${borderColor} flex items-center justify-between`}>
            <h2 className={`font-semibold ${textColor}`}>Hospital Network Map - Full Topology</h2>
            <div className={`flex items-center space-x-2 text-[10px] ${textMuted}`}>
              <span className="flex items-center"><span className="w-2 h-2 bg-red-600 rounded mr-1"></span>FW</span>
              <span className="flex items-center"><span className="w-2 h-2 bg-purple-600 rounded mr-1"></span>Router</span>
              <span className="flex items-center"><span className="w-2 h-2 bg-blue-600 rounded mr-1"></span>Switch</span>
              <span className="flex items-center"><span className="w-2 h-2 bg-emerald-600 rounded mr-1"></span>Server</span>
              <span className="flex items-center"><span className="w-2 h-2 bg-cyan-600 rounded mr-1"></span>Device</span>
              <span className="flex items-center"><span className="w-2 h-2 bg-indigo-500 rounded mr-1"></span>WiFi</span>
            </div>
          </div>
          <div className={`relative ${bgMap} overflow-auto`} style={{ height: '750px' }}>
            <div style={{ transform: `scale(${zoomLevel / 100})`, transformOrigin: 'top left', width: '920px', height: '900px', position: 'relative' }}>
              
              {/* Zone Backgrounds */}
              <div className="absolute rounded-lg border-2 border-purple-500/40 bg-purple-500/10" style={{ left: '260px', top: '55px', width: '300px', height: '130px' }}>
                <span className="absolute top-1 left-2 text-[10px] text-purple-400 font-bold">🏛️ CORE / SECURITY</span>
              </div>
              <div className="absolute rounded-lg border-2 border-blue-500/40 bg-blue-500/10" style={{ left: '10px', top: '300px', width: '220px', height: '380px' }}>
                <span className="absolute top-1 left-2 text-[10px] text-blue-400 font-bold">🏥 ICU (25 devices)</span>
              </div>
              <div className="absolute rounded-lg border-2 border-yellow-500/40 bg-yellow-500/10" style={{ left: '240px', top: '300px', width: '180px', height: '380px' }}>
                <span className="absolute top-1 left-2 text-[10px] text-yellow-400 font-bold">🚑 ER (20 devices)</span>
              </div>
              <div className="absolute rounded-lg border-2 border-green-500/40 bg-green-500/10" style={{ left: '430px', top: '300px', width: '200px', height: '380px' }}>
                <span className="absolute top-1 left-2 text-[10px] text-green-400 font-bold">🛏️ WARD (20 devices)</span>
              </div>
              <div className="absolute rounded-lg border-2 border-cyan-500/40 bg-cyan-500/10" style={{ left: '700px', top: '300px', width: '200px', height: '280px' }}>
                <span className="absolute top-1 left-2 text-[10px] text-cyan-400 font-bold">⚕️ OR (10 devices)</span>
              </div>
              <div className="absolute rounded-lg border-2 border-orange-500/40 bg-orange-500/10" style={{ left: '420px', top: '700px', width: '280px', height: '180px' }}>
                <span className="absolute top-1 left-2 text-[10px] text-orange-400 font-bold">🗄️ DATA CENTER (10 servers)</span>
              </div>
              
              {showAttackers && attackerNodes.length > 0 && (
                <div className="absolute rounded-lg border-2 border-red-500/60 bg-red-500/15 animate-pulse" style={{ left: '700px', top: '10px', width: '210px', height: '160px' }}>
                  <span className="absolute top-1 left-2 text-[10px] text-red-400 font-bold">⚠️ ATTACKERS</span>
                </div>
              )}

              {/* SVG Connections */}
              <svg className="absolute inset-0 pointer-events-none" style={{ width: '920px', height: '900px' }}>
                {connections.map((conn, idx) => {
                  const fromNode = allNodes.find(n => n.id === conn.from);
                  const toNode = allNodes.find(n => n.id === conn.to);
                  if (!fromNode || !toNode) return null;
                  const isAttackLine = (conn as any).isAttack;
                  const isActive = isAttackLine && toNode.attackType && activeAttacks.has(toNode.attackType);
                  return (
                    <line key={idx} x1={fromNode.x + 12} y1={fromNode.y + 12} x2={toNode.x + 12} y2={toNode.y + 12}
                      stroke={isAttackLine ? (isActive ? '#ef4444' : '#555') : '#374151'}
                      strokeWidth={isAttackLine ? (isActive ? 2 : 1) : 1}
                      strokeDasharray={isAttackLine ? '4,4' : 'none'}
                      className={isActive ? 'animate-pulse' : ''} />
                  );
                })}
              </svg>

              {/* Nodes */}
              {allNodes.map((node) => {
                const isAttacking = node.type === 'attacker' && node.attackType && activeAttacks.has(node.attackType);
                const attackColor = node.attackType ? getAttackColor(node.attackType) : undefined;
                return (
                  <div key={node.id} onClick={() => setSelectedNode(node)}
                    className={`absolute cursor-pointer transition-transform hover:scale-125 ${selectedNode?.id === node.id ? 'ring-2 ring-white rounded' : ''} ${isAttacking ? 'animate-bounce' : ''}`}
                    style={{ left: node.x, top: node.y }} title={node.name}>
                    <div className={`w-6 h-6 rounded flex items-center justify-center text-white shadow-md relative ${node.type === 'attacker' ? '' : getNodeColor(node.type)}`}
                      style={node.type === 'attacker' ? { backgroundColor: attackColor } : undefined}>
                      {getNodeIcon(node.type, node.attackType)}
                      <div className={`absolute -top-0.5 -right-0.5 w-2 h-2 ${getStatusIndicator(node.status, node.type)} rounded-full border ${isDark ? 'border-[#080c14]' : 'border-slate-100'}`}></div>
                    </div>
                    <p className={`text-[7px] ${textMuted} text-center mt-0.5 max-w-[45px] truncate leading-tight`}>{node.name}</p>
                  </div>
                );
              })}
            </div>
          </div>
        </div>

        {/* Side Panel */}
        <div className={`${bgCard} rounded-xl border ${borderColor} flex flex-col`} style={{ maxHeight: '800px' }}>
          <div className={`p-3 border-b ${borderColor}`}>
            <h2 className={`font-semibold ${textColor}`}>Node Details</h2>
          </div>
          {selectedNode ? (
            <div className="p-3 space-y-2 overflow-y-auto">
              <div className="flex items-center space-x-2">
                <div className={`w-8 h-8 rounded flex items-center justify-center text-white ${selectedNode.type === 'attacker' ? '' : getNodeColor(selectedNode.type)}`}
                  style={selectedNode.type === 'attacker' ? { backgroundColor: getAttackColor(selectedNode.attackType) } : undefined}>
                  {getNodeIcon(selectedNode.type, selectedNode.attackType)}
                </div>
                <div>
                  <h3 className={`${textColor} font-semibold text-sm`}>{selectedNode.name}</h3>
                  <p className={`${textMuted} text-xs`}>{selectedNode.type}</p>
                </div>
              </div>
              <div className={`${isDark ? 'bg-[#0a0f1c]' : 'bg-slate-100'} rounded p-2 text-xs`}>
                <p className={textFaint}>Status</p>
                <p className={selectedNode.status === 'online' ? 'text-emerald-400' : 'text-red-400'}>{selectedNode.type === 'attacker' ? (activeAttacks.has(selectedNode.attackType || '') ? 'Attacking' : (attackCounts[selectedNode.attackType || ''] > 0 ? 'Active' : 'Idle')) : selectedNode.status}</p>
              </div>
              <div className={`${isDark ? 'bg-[#0a0f1c]' : 'bg-slate-100'} rounded p-2 text-xs`}>
                <p className={textFaint}>IP Address</p>
                <p className={`${textColor} font-mono`}>{selectedNode.ip}</p>
              </div>
              <div className={`${isDark ? 'bg-[#0a0f1c]' : 'bg-slate-100'} rounded p-2 text-xs`}>
                <p className={textFaint}>Zone</p>
                <p className={textColor}>{selectedNode.zone}</p>
              </div>
              {selectedNode.type === "attacker" && (
                <div className={`${isDark ? "bg-[#0a0f1c]" : "bg-slate-100"} rounded p-2 text-xs`}>
                  <p className={textFaint}>Attack Count</p>
                  <p className={`text-red-400 font-bold`}>{attackCounts[selectedNode.attackType || ""] || 0}</p>
                </div>
              )}
              </div>
                <button className={`flex-1 px-2 py-1.5 ${isDark ? 'bg-gray-700' : 'bg-slate-200'} ${textColor} text-xs rounded`}>Details</button>
              </div>
            </div>
          ) : (
            <div className="p-4 text-center">
              <p className={`${textMuted} text-sm`}>Click a node</p>
            </div>
          )}
          
          {/* Zones */}
          <div className={`p-3 border-t ${borderColor}`}>
            <h3 className={`text-xs font-medium ${textColor} mb-2`}>Zones</h3>
            <div className="space-y-1 text-[10px]">
              <div className="flex justify-between"><span className="text-blue-400">ICU</span><span className={textMuted}>25 devices</span></div>
              <div className="flex justify-between"><span className="text-yellow-400">ER</span><span className={textMuted}>20 devices</span></div>
              <div className="flex justify-between"><span className="text-green-400">Ward</span><span className={textMuted}>20 devices</span></div>
              <div className="flex justify-between"><span className="text-cyan-400">OR</span><span className={textMuted}>10 devices</span></div>
              <div className="flex justify-between"><span className="text-orange-400">DC</span><span className={textMuted}>10 servers</span></div>
            </div>
          </div>

          {/* Attacks */}
          <div className={`p-3 border-t ${borderColor} flex-1 overflow-y-auto`}>
            <h3 className={`text-xs font-medium ${textColor} mb-2`}>Attacks</h3>
            <div className="space-y-1">
              {ALL_ATTACK_TYPES.filter(a => a.key !== 'Benign').map((attack) => {
                const count = attackCounts[attack.key] || 0;
                const isActive = activeAttacks.has(attack.key);
                return (
                  <div key={attack.key} className={`flex items-center justify-between text-[10px] p-1 rounded ${isActive ? 'bg-red-500/20' : ''}`}>
                    <span style={{ color: attack.color }}>{attack.icon} {attack.name}</span>
                    <span className={count > 0 ? 'text-red-400 font-bold' : textFaint}>{count}</span>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>

      {/* Ping Modal */}
      {pingResult.show && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50" onClick={() => setPingResult({show: false, ip: '', results: [], status: null})}>
          <div className={`${isDark ? 'bg-[#0d1424]' : 'bg-white'} border ${borderColor} rounded-xl p-4 w-96`} onClick={e => e.stopPropagation()}>
            <div className="flex justify-between items-center mb-3">
              <h3 className={`font-bold ${textColor}`}>🖥️ Ping {pingResult.ip}</h3>
              <button onClick={() => setPingResult({show: false, ip: '', results: [], status: null})} className={textMuted}>&times;</button>
            </div>
            <div className="bg-black rounded-lg p-3 font-mono text-xs text-green-400 h-40 overflow-y-auto">
              <p className="text-gray-500">$ ping {pingResult.ip}</p>
              {pingResult.results.map((line: string, i: number) => <p key={i}>{line}</p>)}
              {pingResult.status === 'pinging' && <span className="animate-pulse">▋</span>}
            </div>
            <div className="mt-3 flex justify-between">
              <span className={`text-xs ${pingResult.status === 'success' ? 'text-green-400' : 'text-yellow-400'}`}>
                {pingResult.status === 'success' ? '✓ Done' : '⏳ Pinging...'}
              </span>
              <button onClick={() => setPingResult({show: false, ip: '', results: [], status: null})} className="px-3 py-1 bg-blue-600 text-white text-xs rounded">Close</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default NetworkTopology;
