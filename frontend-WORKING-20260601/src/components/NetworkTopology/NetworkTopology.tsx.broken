import React, { useState, useEffect, useRef } from 'react';
import { useTheme } from '../../ThemeContext';

interface NetworkNode {
  id: string;
  name: string;
  type: 'firewall' | 'router' | 'switch' | 'server' | 'device' | 'attacker' | 'ids' | 'wifi' | 'gateway';
  status: 'online' | 'offline' | 'warning' | 'attacking';
  ip: string;
  zone: string;
  x: number;
  y: number;
  attackType?: string;
  count?: number;
}

const ALL_ATTACK_TYPES = [
  { key: 'DDoS', name: 'DDoS', color: '#ef4444', icon: '⚡' },
  { key: 'DoS', name: 'DoS', color: '#f97316', icon: '🔥' },
  { key: 'ICMP_Flood', name: 'ICMP Flood', color: '#06b6d4', icon: '🌊' },
  { key: 'ARP_Spoofing', name: 'ARP Spoofing', color: '#10b981', icon: '🎭' },
  { key: 'MQTT_Attack', name: 'MQTT Attack', color: '#ec4899', icon: '📡' },
  { key: 'Ransomware', name: 'Ransomware', color: '#8b5cf6', icon: '🔒' },
  { key: 'Reconnaissance', name: 'Reconnaissance', color: '#6366f1', icon: '🔍' },
  { key: 'Data_Exfiltration', name: 'Data Exfiltration', color: '#f59e0b', icon: '📤' },
  { key: 'Benign', name: 'Benign', color: '#22c55e', icon: '✓' },
];

const NetworkTopology: React.FC = () => {
  const { theme } = useTheme();
  const isDark = theme === 'dark';
  const [selectedNode, setSelectedNode] = useState<NetworkNode | null>(null);
  const [showAttackers, setShowAttackers] = useState(true);
  const [zoomLevel, setZoomLevel] = useState(85);
  const [currentAttack, setCurrentAttack] = useState<string>('None');
  const [attackCounts, setAttackCounts] = useState<Record<string, number>>({});
  const [activeAttacks, setActiveAttacks] = useState<Set<string>>(new Set());
  const [isConnected, setIsConnected] = useState(false);
  const [pingResult, setPingResult] = useState<{show: boolean; ip: string; results: string[]; status: 'pinging' | 'success' | 'failed' | null}>({show: false, ip: '', results: [], status: null});
  const wsRef = useRef<WebSocket | null>(null);

  useEffect(() => {
    const fetchData = async () => {
      try {
        const response = await fetch('http://localhost:8000/api/network/attacks');
        if (response.ok) {
          const data = await response.json();
          setAttackCounts(data.counts || {});
        }
      } catch (e) { /* ignore */ }
    };
    fetchData();
    const interval = setInterval(fetchData, 1000);
    return () => clearInterval(interval);
  }, []);

  useEffect(() => {
    const connectWebSocket = () => {
      try {
        const ws = new WebSocket('ws://localhost:8000/ws');
        wsRef.current = ws;
        ws.onopen = () => setIsConnected(true);
        ws.onclose = () => {
          setIsConnected(false);
          setTimeout(connectWebSocket, 3000);
        };
        ws.onmessage = (event) => {
          try {
            const data = JSON.parse(event.data);
            if (data.attack_type) {
              setCurrentAttack(data.attack_type);
              const attackType = data.attack_type;
              if (attackType !== 'Benign') {
                setActiveAttacks(prev => new Set([...Array.from(prev), attackType]));
                setTimeout(() => {
                  setActiveAttacks(prev => {
                    const newSet = new Set(Array.from(prev));
                    newSet.delete(attackType);
                    return newSet;
                  });
                }, 3000);
              }
            }
          } catch (e) { /* ignore */ }
        };
      } catch (e) {
        setTimeout(connectWebSocket, 3000);
      }
    };
    connectWebSocket();
    return () => wsRef.current?.close();
  }, []);

  const handlePing = (ip: string) => {
    setPingResult({ show: true, ip, results: [], status: 'pinging' });
    const pingMessages: string[] = [];
    let count = 0;
    const interval = setInterval(() => {
      if (count < 4) {
        const time = Math.floor(Math.random() * 50) + 10;
        pingMessages.push(`64 bytes from ${ip}: icmp_seq=${count + 1} ttl=64 time=${time}ms`);
        setPingResult(prev => ({ ...prev, results: [...pingMessages] }));
        count++;
      } else {
        clearInterval(interval);
        setPingResult(prev => ({ ...prev, status: 'success', results: [...pingMessages, '', `--- ${ip} ping statistics ---`, '4 packets transmitted, 4 received, 0% packet loss'] }));
      }
    }, 500);
  };

  const getAttackColor = (attackType?: string) => {
    const attack = ALL_ATTACK_TYPES.find(a => a.key === attackType);
    return attack?.color || '#666';
  };

  // ============================================
  // FULL HOSPITAL NETWORK - ALL 85 DEVICES
  // ============================================
  const nodes: NetworkNode[] = [
    // ========== INTERNET & CORE ==========
    { id: 'internet', name: 'Internet', type: 'gateway', status: 'online', ip: 'WAN', zone: 'External', x: 500, y: 10 },
    { id: 'firewall', name: 'Firewall', type: 'firewall', status: 'online', ip: '10.0.0.1', zone: 'Core', x: 500, y: 70 },
    
    // ========== SECURITY ZONE ==========
    { id: 'ids_ips', name: 'IDS/IPS (AEGIS)', type: 'ids', status: 'online', ip: '10.0.0.5', zone: 'Security', x: 350, y: 70 },
