  const attackerNodes: NetworkNode[] = showAttackers ? ALL_ATTACK_TYPES
    .filter(a => a.key !== 'Benign')
    .slice(0, 8)
    .map((attack, idx) => ({
      id: `attacker_${attack.key}`,
      name: attack.name,
      type: 'attacker' as const,
      status: activeAttacks.has(attack.key) ? 'attacking' as const : 'warning' as const,
      ip: `192.168.${100 + idx}.${Math.floor(Math.random() * 254) + 1}`,
      zone: 'Attacker',
      x: 720 + (idx % 4) * 50,
      y: 30 + Math.floor(idx / 4) * 70,
      attackType: attack.key,
      count: attackCounts[attack.key] || 0,
    })) : [];

  const allNodes = [...nodes, ...attackerNodes];

  // ========== CONNECTIONS ==========
  const connections = [
    // Core
    { from: 'internet', to: 'firewall' },
    { from: 'firewall', to: 'ids_ips' },
    { from: 'firewall', to: 'core_router' },
    { from: 'ids_ips', to: 'sec_switch' },
    { from: 'sec_switch', to: 'sec_monitor' },
    { from: 'sec_switch', to: 'log_server' },
    { from: 'core_router', to: 'dist_switch1' },
    { from: 'core_router', to: 'dist_switch2' },
    { from: 'core_router', to: 'dc_switch' },
    // Distribution
