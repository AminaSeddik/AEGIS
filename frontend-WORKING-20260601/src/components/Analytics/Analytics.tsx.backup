import React, { useState, useEffect } from 'react';
// NOTE: Run this in your terminal first:
// npm install jspdf jspdf-autotable
// Then uncomment the imports below:
// import jsPDF from 'jspdf';
// import 'jspdf-autotable';

interface ThreatStats {
  total: number;
  active: number;
  blocked: number;
  critical: number;
  by_type: { [key: string]: number };
}

const Analytics: React.FC = () => {
  const [timeRange, setTimeRange] = useState('7d');
  const [threatStats, setThreatStats] = useState<ThreatStats | null>(null);
  const [isExporting, setIsExporting] = useState(false);
  const [exportSuccess, setExportSuccess] = useState(false);

  // Fetch stats from backend
  useEffect(() => {
    const fetchStats = async () => {
      try {
        const response = await fetch('http://localhost:8000/api/threats/stats');
        if (response.ok) {
          const data = await response.json();
          setThreatStats(data);
        }
      } catch (error) {
        console.error('Failed to fetch threat stats:', error);
      }
    };
    fetchStats();
  }, []);

  // Sample data for charts (will be replaced with real data)
  const threatData = {
    ddos: threatStats?.by_type?.ddos || 58,
    exfiltration: threatStats?.by_type?.data_exfiltration || 30,
    ransomware: threatStats?.by_type?.ransomware || 12,
  };

  const totalThreats = threatStats?.total || 121;
  const blockedThreats = threatStats?.blocked || 98;
  const blockRate = totalThreats > 0 ? Math.round((blockedThreats / totalThreats) * 100) : 81;

  // Weekly data for bar chart
  const weeklyData = [
    { day: 'Mon', ddos: 12, exfil: 5, ransom: 2 },
    { day: 'Tue', ddos: 8, exfil: 7, ransom: 1 },
    { day: 'Wed', ddos: 15, exfil: 4, ransom: 3 },
    { day: 'Thu', ddos: 10, exfil: 8, ransom: 2 },
    { day: 'Fri', ddos: 18, exfil: 6, ransom: 4 },
    { day: 'Sat', ddos: 6, exfil: 3, ransom: 1 },
    { day: 'Sun', ddos: 4, exfil: 2, ransom: 0 },
  ];

  // Hourly data
  const hourlyData = [
    { hour: '00:00', threats: 2 }, { hour: '02:00', threats: 1 },
    { hour: '04:00', threats: 3 }, { hour: '06:00', threats: 5 },
    { hour: '08:00', threats: 12 }, { hour: '10:00', threats: 18 },
    { hour: '12:00', threats: 15 }, { hour: '14:00', threats: 22 },
    { hour: '16:00', threats: 19 }, { hour: '18:00', threats: 14 },
    { hour: '20:00', threats: 8 }, { hour: '22:00', threats: 4 },
  ];

  // Top targeted devices
  const topDevices = [
    { name: 'Infusion Pump ICU-3', zone: 'ICU', threats: 15, severity: 'critical' },
    { name: 'Patient Monitor Ward-5', zone: 'Ward', threats: 12, severity: 'high' },
    { name: 'ECG Monitor ER-2', zone: 'ER', threats: 9, severity: 'high' },
    { name: 'Ventilator ICU-1', zone: 'ICU', threats: 7, severity: 'medium' },
    { name: 'MRI Scanner', zone: 'Radiology', threats: 5, severity: 'medium' },
  ];

  // Device type stats
  const deviceStats = [
    { type: 'Ventilators', online: 5, total: 5 },
    { type: 'ECG Monitors', online: 9, total: 9 },
    { type: 'Infusion Pumps', online: 8, total: 8 },
    { type: 'Patient Monitors', online: 7, total: 8 },
    { type: 'Defibrillators', online: 4, total: 4 },
    { type: 'Anesthesia', online: 3, total: 3 },
  ];

  // Security metrics
  const securityMetrics = [
    { name: 'Threat Detection', value: 92 },
    { name: 'Response Time', value: 88 },
    { name: 'Device Coverage', value: 95 },
    { name: 'Patch Status', value: 76 },
  ];

  const securityScore = 87;

  // PDF EXPORT FUNCTION
  const handleExportPDF = async () => {
    setIsExporting(true);
    
    try {
      // Dynamic import of jsPDF
      const { default: jsPDF } = await import('jspdf');
      
      const doc = new jsPDF();
      const pageWidth = doc.internal.pageSize.getWidth();
      let yPos = 20;

      // Helper function to add text
      const addText = (text: string, x: number, y: number, options?: any) => {
        doc.text(text, x, y, options);
      };

      // Title
      doc.setFontSize(24);
      doc.setTextColor(41, 98, 255);
      addText('AEGIS Security Report', pageWidth / 2, yPos, { align: 'center' });
      
      yPos += 10;
      doc.setFontSize(12);
      doc.setTextColor(100, 100, 100);
      addText(`Generated: ${new Date().toLocaleString()}`, pageWidth / 2, yPos, { align: 'center' });
      
      yPos += 5;
      addText(`Time Range: Last ${timeRange === '24h' ? '24 Hours' : timeRange === '7d' ? '7 Days' : timeRange === '30d' ? '30 Days' : '90 Days'}`, pageWidth / 2, yPos, { align: 'center' });

      // Horizontal line
      yPos += 10;
      doc.setDrawColor(200, 200, 200);
      doc.line(20, yPos, pageWidth - 20, yPos);

      // Executive Summary
      yPos += 15;
      doc.setFontSize(16);
      doc.setTextColor(0, 0, 0);
      addText('Executive Summary', 20, yPos);
      
      yPos += 10;
      doc.setFontSize(11);
      doc.setTextColor(60, 60, 60);
      addText(`Total Threats Detected: ${totalThreats}`, 25, yPos);
      yPos += 7;
      addText(`Threats Blocked: ${blockedThreats} (${blockRate}%)`, 25, yPos);
      yPos += 7;
      addText(`Active Threats: ${threatStats?.active || 0}`, 25, yPos);
      yPos += 7;
      addText(`Critical Alerts: ${threatStats?.critical || 0}`, 25, yPos);
      yPos += 7;
      addText(`Security Score: ${securityScore}/100`, 25, yPos);
      yPos += 7;
      addText(`Average Response Time: 1.2 seconds`, 25, yPos);

      // Threat Distribution
      yPos += 15;
      doc.setFontSize(16);
      doc.setTextColor(0, 0, 0);
      addText('Threat Distribution', 20, yPos);
      
      yPos += 10;
      doc.setFontSize(11);
      doc.setTextColor(60, 60, 60);
      const totalByType = threatData.ddos + threatData.exfiltration + threatData.ransomware;
      addText(`• DDoS Attacks: ${threatData.ddos} (${Math.round(threatData.ddos / totalByType * 100)}%)`, 25, yPos);
      yPos += 7;
      addText(`• Data Exfiltration: ${threatData.exfiltration} (${Math.round(threatData.exfiltration / totalByType * 100)}%)`, 25, yPos);
      yPos += 7;
      addText(`• Ransomware: ${threatData.ransomware} (${Math.round(threatData.ransomware / totalByType * 100)}%)`, 25, yPos);

      // Top Targeted Devices
      yPos += 15;
      doc.setFontSize(16);
      doc.setTextColor(0, 0, 0);
      addText('Top Targeted Devices', 20, yPos);
      
      yPos += 10;
      doc.setFontSize(11);
      doc.setTextColor(60, 60, 60);
      topDevices.forEach((device, index) => {
        addText(`${index + 1}. ${device.name} (${device.zone}) - ${device.threats} threats [${device.severity.toUpperCase()}]`, 25, yPos);
        yPos += 7;
      });

      // Security Metrics
      yPos += 10;
      doc.setFontSize(16);
      doc.setTextColor(0, 0, 0);
      addText('Security Metrics', 20, yPos);
      
      yPos += 10;
      doc.setFontSize(11);
      doc.setTextColor(60, 60, 60);
      securityMetrics.forEach((metric) => {
        const status = metric.value >= 90 ? 'EXCELLENT' : metric.value >= 80 ? 'GOOD' : metric.value >= 70 ? 'FAIR' : 'NEEDS ATTENTION';
        addText(`• ${metric.name}: ${metric.value}% - ${status}`, 25, yPos);
        yPos += 7;
      });

      // Network Information
      yPos += 10;
      doc.setFontSize(16);
      doc.setTextColor(0, 0, 0);
      addText('Network Information', 20, yPos);
      
      yPos += 10;
      doc.setFontSize(11);
      doc.setTextColor(60, 60, 60);
      addText(`• Total Devices: 85`, 25, yPos);
      yPos += 7;
      addText(`• Devices Online: 85 (100%)`, 25, yPos);
      yPos += 7;
      addText(`• Network Zones: ICU, ER, Ward, OR, Data Center`, 25, yPos);
      yPos += 7;
      addText(`• Monitoring: OMNeT++ Simulation Connected`, 25, yPos);

      // Recommendations
      yPos += 15;
      doc.setFontSize(16);
      doc.setTextColor(0, 0, 0);
      addText('Recommendations', 20, yPos);
      
      yPos += 10;
      doc.setFontSize(11);
      doc.setTextColor(60, 60, 60);
      addText(`1. Update firmware on devices with patch status below 80%`, 25, yPos);
      yPos += 7;
      addText(`2. Investigate repeated attacks on Infusion Pump ICU-3`, 25, yPos);
      yPos += 7;
      addText(`3. Review network segmentation for ICU zone`, 25, yPos);
      yPos += 7;
      addText(`4. Enable additional monitoring for high-value targets`, 25, yPos);

      // Footer
      yPos = doc.internal.pageSize.getHeight() - 20;
      doc.setFontSize(9);
      doc.setTextColor(150, 150, 150);
      addText('AEGIS - AI-Based Intrusion Detection System for Medical IoT', pageWidth / 2, yPos, { align: 'center' });
      yPos += 5;
      addText('Confidential Security Report - Do Not Distribute', pageWidth / 2, yPos, { align: 'center' });

      // Save the PDF
      const fileName = `AEGIS_Security_Report_${new Date().toISOString().split('T')[0]}.pdf`;
      doc.save(fileName);
      
      setExportSuccess(true);
      setTimeout(() => setExportSuccess(false), 3000);
      
    } catch (error) {
      console.error('PDF Export Error:', error);
      // Fallback: Show alert with instructions
      alert('To enable PDF export:\n\n1. Open terminal in frontend folder\n2. Run: npm install jspdf\n3. Refresh the page\n\nError: ' + error);
    } finally {
      setIsExporting(false);
    }
  };

  const maxWeekly = Math.max(...weeklyData.flatMap(d => [d.ddos, d.exfil, d.ransom]));
  const maxHourly = Math.max(...hourlyData.map(d => d.threats));

  return (
    <div className="min-h-screen bg-[#0a0f1c] p-6">
      {/* Header */}
      <div className="flex items-center justify-between mb-6">
        <div>
          <h1 className="text-3xl font-bold text-white mb-1">Analytics</h1>
          <p className="text-gray-500">Security metrics and threat analysis</p>
        </div>
        <div className="flex items-center space-x-3">
          {/* Time Range */}
          <div className="flex bg-[#1a1f2e] rounded-lg p-1">
            {['24h', '7d', '30d', '90d'].map((range) => (
              <button
                key={range}
                onClick={() => setTimeRange(range)}
                className={`px-4 py-2 rounded-md text-sm font-medium transition-colors ${
                  timeRange === range
                    ? 'bg-blue-600 text-white'
                    : 'text-gray-400 hover:text-white'
                }`}
              >
                {range}
              </button>
            ))}
          </div>

          {/* Export PDF Button */}
          <button
            onClick={handleExportPDF}
            disabled={isExporting}
            className={`px-4 py-2 rounded-lg font-medium transition-all flex items-center space-x-2 ${
              exportSuccess
                ? 'bg-emerald-600 text-white'
                : isExporting
                ? 'bg-gray-600 text-gray-300 cursor-wait'
                : 'bg-blue-600 hover:bg-blue-700 text-white'
            }`}
          >
            {isExporting ? (
              <>
                <svg className="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>Generating...</span>
              </>
            ) : exportSuccess ? (
              <>
                <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
                </svg>
                <span>Downloaded!</span>
              </>
            ) : (
              <>
                <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span>Export PDF</span>
              </>
            )}
          </button>
        </div>
      </div>

      {/* Summary Cards */}
      <div className="grid grid-cols-4 gap-4 mb-6">
        <div className="bg-gradient-to-br from-[#0d1424] to-[#1a1f2e] rounded-xl p-4 border border-gray-800">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-gray-400 text-xs">Total Threats</p>
              <p className="text-2xl font-bold text-white">{totalThreats}</p>
              <p className="text-red-400 text-xs flex items-center mt-1">
                <svg className="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 9l-7 7-7-7" /></svg>
                ↓12% from last period
              </p>
            </div>
            <div className="w-12 h-12 bg-red-500/20 rounded-xl flex items-center justify-center">
              <svg className="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            </div>
          </div>
        </div>

        <div className="bg-gradient-to-br from-[#0d1424] to-[#1a1f2e] rounded-xl p-4 border border-gray-800">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-gray-400 text-xs">Blocked</p>
              <p className="text-2xl font-bold text-emerald-400">{blockedThreats}</p>
              <p className="text-emerald-400 text-xs mt-1">{blockRate}% block rate</p>
            </div>
            <div className="w-12 h-12 bg-emerald-500/20 rounded-xl flex items-center justify-center">
              <svg className="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            </div>
          </div>
        </div>

        <div className="bg-gradient-to-br from-[#0d1424] to-[#1a1f2e] rounded-xl p-4 border border-gray-800">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-gray-400 text-xs">Avg Response</p>
              <p className="text-2xl font-bold text-blue-400">1.2s</p>
              <p className="text-emerald-400 text-xs flex items-center mt-1">
                <svg className="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 15l7-7 7 7" /></svg>
                ↓0.3s improvement
              </p>
            </div>
            <div className="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center">
              <svg className="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>
          </div>
        </div>

        <div className="bg-gradient-to-br from-[#0d1424] to-[#1a1f2e] rounded-xl p-4 border border-gray-800">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-gray-400 text-xs">Uptime</p>
              <p className="text-2xl font-bold text-purple-400">99.9%</p>
              <p className="text-gray-500 text-xs mt-1">Last 30 days</p>
            </div>
            <div className="w-12 h-12 bg-purple-500/20 rounded-xl flex items-center justify-center">
              <svg className="w-6 h-6 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
          </div>
        </div>
      </div>

      {/* Charts Row */}
      <div className="grid grid-cols-3 gap-6 mb-6">
        {/* Threat Trends - Bar Chart */}
        <div className="col-span-2 bg-gradient-to-br from-[#0d1424] to-[#1a1f2e] rounded-2xl border border-gray-800 p-6">
          <h3 className="text-lg font-semibold text-white mb-4">Threat Trends (Last 7 Days)</h3>
          <div className="flex items-end justify-between h-48 mt-4">
            {weeklyData.map((day, idx) => (
              <div key={idx} className="flex flex-col items-center space-y-1 flex-1">
                <div className="flex items-end space-x-1 h-36">
                  <div
                    className="w-4 bg-red-500 rounded-t transition-all"
                    style={{ height: `${(day.ddos / maxWeekly) * 100}%` }}
                    title={`DDoS: ${day.ddos}`}
                  ></div>
                  <div
                    className="w-4 bg-yellow-500 rounded-t transition-all"
                    style={{ height: `${(day.exfil / maxWeekly) * 100}%` }}
                    title={`Exfiltration: ${day.exfil}`}
                  ></div>
                  <div
                    className="w-4 bg-purple-500 rounded-t transition-all"
                    style={{ height: `${(day.ransom / maxWeekly) * 100}%` }}
                    title={`Ransomware: ${day.ransom}`}
                  ></div>
                </div>
                <span className="text-gray-500 text-xs">{day.day}</span>
              </div>
            ))}
          </div>
          <div className="flex items-center justify-center space-x-6 mt-4">
            <div className="flex items-center space-x-2">
              <div className="w-3 h-3 bg-red-500 rounded"></div>
              <span className="text-gray-400 text-xs">DDoS</span>
            </div>
            <div className="flex items-center space-x-2">
              <div className="w-3 h-3 bg-yellow-500 rounded"></div>
              <span className="text-gray-400 text-xs">Exfiltration</span>
            </div>
            <div className="flex items-center space-x-2">
              <div className="w-3 h-3 bg-purple-500 rounded"></div>
              <span className="text-gray-400 text-xs">Ransomware</span>
            </div>
          </div>
        </div>

        {/* Attack Distribution - Donut Chart */}
        <div className="bg-gradient-to-br from-[#0d1424] to-[#1a1f2e] rounded-2xl border border-gray-800 p-6">
          <h3 className="text-lg font-semibold text-white mb-4">Attack Distribution</h3>
          <div className="relative w-40 h-40 mx-auto">
            <svg viewBox="0 0 36 36" className="w-full h-full">
              {/* DDoS - Red */}
              <circle cx="18" cy="18" r="15.915" fill="none" stroke="#ef4444" strokeWidth="3"
                strokeDasharray="58 42" strokeDashoffset="25" />
              {/* Exfiltration - Yellow */}
              <circle cx="18" cy="18" r="15.915" fill="none" stroke="#eab308" strokeWidth="3"
                strokeDasharray="30 70" strokeDashoffset="67" />
              {/* Ransomware - Purple */}
              <circle cx="18" cy="18" r="15.915" fill="none" stroke="#a855f7" strokeWidth="3"
                strokeDasharray="12 88" strokeDashoffset="37" />
            </svg>
            <div className="absolute inset-0 flex items-center justify-center">
              <div className="text-center">
                <p className="text-2xl font-bold text-white">{totalThreats}</p>
                <p className="text-gray-500 text-xs">Total</p>
              </div>
            </div>
          </div>
          <div className="space-y-2 mt-4">
            <div className="flex items-center justify-between">
              <div className="flex items-center space-x-2">
                <div className="w-3 h-3 bg-red-500 rounded"></div>
                <span className="text-gray-400 text-sm">DDoS</span>
              </div>
              <span className="text-white font-medium">{threatData.ddos}%</span>
            </div>
            <div className="flex items-center justify-between">
              <div className="flex items-center space-x-2">
                <div className="w-3 h-3 bg-yellow-500 rounded"></div>
                <span className="text-gray-400 text-sm">Exfiltration</span>
              </div>
              <span className="text-white font-medium">{threatData.exfiltration}%</span>
            </div>
            <div className="flex items-center justify-between">
              <div className="flex items-center space-x-2">
                <div className="w-3 h-3 bg-purple-500 rounded"></div>
                <span className="text-gray-400 text-sm">Ransomware</span>
              </div>
              <span className="text-white font-medium">{threatData.ransomware}%</span>
            </div>
          </div>
        </div>
      </div>

      {/* Bottom Row */}
      <div className="grid grid-cols-3 gap-6">
        {/* Hourly Activity */}
        <div className="bg-gradient-to-br from-[#0d1424] to-[#1a1f2e] rounded-2xl border border-gray-800 p-6">
          <h3 className="text-lg font-semibold text-white mb-4">Hourly Activity</h3>
          <div className="flex items-end justify-between h-32">
            {hourlyData.map((hour, idx) => (
              <div key={idx} className="flex flex-col items-center flex-1">
                <div
                  className="w-3 bg-blue-500 rounded-t transition-all hover:bg-blue-400"
                  style={{ height: `${(hour.threats / maxHourly) * 100}%`, minHeight: '4px' }}
                ></div>
                {idx % 2 === 0 && (
                  <span className="text-gray-600 text-[9px] mt-1">{hour.hour.split(':')[0]}</span>
                )}
              </div>
            ))}
          </div>
          <p className="text-gray-500 text-xs text-center mt-2">Peak activity: 14:00 - 16:00</p>
        </div>

        {/* Top Targeted Devices */}
        <div className="bg-gradient-to-br from-[#0d1424] to-[#1a1f2e] rounded-2xl border border-gray-800 p-6">
          <h3 className="text-lg font-semibold text-white mb-4">Top Targeted Devices</h3>
          <div className="space-y-3">
            {topDevices.map((device, idx) => (
              <div key={idx} className="flex items-center justify-between">
                <div className="flex items-center space-x-3">
                  <span className="text-gray-500 text-sm w-4">{idx + 1}.</span>
                  <div>
                    <p className="text-white text-sm">{device.name}</p>
                    <p className="text-gray-500 text-xs">{device.zone}</p>
                  </div>
                </div>
                <div className="flex items-center space-x-2">
                  <span className="text-gray-400 text-sm">{device.threats}</span>
                  <span className={`text-xs px-2 py-0.5 rounded ${
                    device.severity === 'critical' ? 'bg-red-500/20 text-red-400' :
                    device.severity === 'high' ? 'bg-yellow-500/20 text-yellow-400' :
                    'bg-blue-500/20 text-blue-400'
                  }`}>
                    {device.severity}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Security Score */}
        <div className="bg-gradient-to-br from-[#0d1424] to-[#1a1f2e] rounded-2xl border border-gray-800 p-6">
          <h3 className="text-lg font-semibold text-white mb-4">Security Score</h3>
          <div className="relative w-32 h-32 mx-auto mb-4">
            <svg viewBox="0 0 36 36" className="w-full h-full -rotate-90">
              <circle cx="18" cy="18" r="15.915" fill="none" stroke="#1f2937" strokeWidth="3" />
              <circle cx="18" cy="18" r="15.915" fill="none" stroke="#10b981" strokeWidth="3"
                strokeDasharray={`${securityScore} ${100 - securityScore}`} strokeLinecap="round" />
            </svg>
            <div className="absolute inset-0 flex items-center justify-center">
              <div className="text-center">
                <p className="text-3xl font-bold text-white">{securityScore}</p>
                <p className="text-gray-500 text-xs">/100</p>
              </div>
            </div>
          </div>
          <div className="space-y-2">
            {securityMetrics.map((metric, idx) => (
              <div key={idx}>
                <div className="flex justify-between text-xs mb-1">
                  <span className="text-gray-400">{metric.name}</span>
                  <span className="text-white">{metric.value}%</span>
                </div>
                <div className="h-1.5 bg-gray-700 rounded-full overflow-hidden">
                  <div
                    className={`h-full rounded-full ${
                      metric.value >= 90 ? 'bg-emerald-500' :
                      metric.value >= 80 ? 'bg-blue-500' :
                      metric.value >= 70 ? 'bg-yellow-500' : 'bg-red-500'
                    }`}
                    style={{ width: `${metric.value}%` }}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
};

export default Analytics;
